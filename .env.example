# --- Identity ---
PROJECT_NAME=NeonPanel
VERSION=1.0.0
ADMIN_USER=RXpanel
ADMIN_PASS=                # empty = random at first run (printed once in log)
JWT_SECRET=                # empty = random, stored in .data/jwt_secret

# --- Network ---
PORT=8080
PUBLIC_DOMAIN=             # empty = auto-detect
ALLOWED_HOSTS=            # empty = all hosts allowed
REALITY_PORT=8443
REALITY_SNI=www.microsoft.com
SS_PORT=8388               # 0 = disabled
MT_ENABLED=0
MT_PORT=4433

# --- Tunnel ---
CF_MODE=off                # off | token | quick
CF_TUNNEL_TOKEN=           # only for token mode

# --- Railway ---
RAILWAY_PUBLIC_DOMAIN=     # set by Railway itself
RAILWAY_TCP_PROXY_DOMAIN=  # suggested MTProto host (optional)

# --- Internal ---
XRAY_VERSION=26.3.27
DATA_DIR=.data
LOG_LEVEL=info
CORS_ORIGINS=
